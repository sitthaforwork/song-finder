# คัดลอกไฟล์นี้เป็น .env แล้วใส่ key ที่มี (ไม่ต้องใส่ครบทุกตัว)
# ถ้าไม่ใส่ key เลย เว็บจะทำงานใน "โหมดจำลอง" (mock) ให้ลองใช้งานได้ก่อน

PORT=3000

# OpenRouter: สมัครที่ https://openrouter.ai  -> Keys  (มีโมเดล :free หลายตัว)
OPENROUTER_API_KEY=

# Groq: สมัครที่ https://console.groq.com  -> API Keys  (ฟรี ไม่ต้องใช้บัตร, เร็วมาก)
GROQ_API_KEY=

# Google Gemini: สมัครที่ https://aistudio.google.com -> Get API key  (ฟรีเฉพาะรุ่น Flash)
GEMINI_API_KEY=

# Tavily (ค้นเว็บให้ AI): สมัครที่ https://app.tavily.com  (แผนฟรี 1,000 เครดิต/เดือน ไม่ต้องใช้บัตร)
# ใช้คู่กับ GROQ_API_KEY เพื่อเปิดตัวเลือก "Tavily Search (Groq)" ที่ค้นเว็บหาเนื้อเพลงก่อนตอบ
TAVILY_API_KEY=

# (ไม่บังคับ) ปกติเว็บจะดึงรายชื่อโมเดลที่ใช้ได้จริงจากแต่ละเจ้าให้อัตโนมัติ
# ถ้าอยากกำหนดเอง ให้ใส่ชื่อโมเดล คั่นด้วยจุลภาค (จะใช้แทนค่าอัตโนมัติของเจ้านั้น)
# ตัวอย่าง: OPENROUTER_MODELS=openrouter/free,meta-llama/llama-3.3-70b-instruct:free
OPENROUTER_MODELS=
GROQ_MODELS=
GEMINI_MODELS=
